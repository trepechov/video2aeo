        {
          "@type": "Question",
          "name": "Кога наемът е по-изгоден от покупката?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Когато цената на жилището е над 20 годишни наема или когато планирате да останете по-малко от 5 години."
          }
        },
        {
          "@type": "Question",
          "name": "Как се смята съотношението цена към наем?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Цената на жилището се дели на годишния наем. Пример: 120 000 € делено на 6 000 € годишен наем дава 20."
          }
        },
        {
          "@type": "Question",
          "name": "Колко струва сделката при покупка на жилище?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Около 3% от цената за нотариус, такси и комисиона, плюс около 1% годишно за поддръжка."
          }
        },
        {
          "@type": "Question",
          "name": "След колко години покупката се изплаща?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "При хоризонт над 10 години покупката печели в повечето сценарии, разгледани в епизода."
          }
        },
        {
          "@type": "Question",
          "name": "Трябва ли да сравнявам и доходността на самоучастието?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Самоучастието от 20%, ако бъде инвестирано, също носи доходност и трябва да влезе в сравнението."
          }
